# RSI-only backtest profile
# Usage: DOTENV_CONFIG_PATH=.env.backtest-rsi node run-empire-v2.js

# Strategy toggles - RSI only
ENABLE_RSI=true
ENABLE_MASR=false
ENABLE_EMA=false
ENABLE_LIQSWEEP=false
ENABLE_REGIME=false
ENABLE_MTF=false
ENABLE_TPO=false

# Execution
CANDLE_SOURCE=file
CANDLE_FILE=tuning/full-45k.json
EXECUTION_MODE=backtest
DIRECTION_FILTER=both

# Skip heavy components for speed
ENABLE_TRAI=false
ENABLE_DASHBOARD=false
ENABLE_NOTIFICATIONS=false
RISK_MANAGER_BYPASS=true
ACCOUNT_DRAWDOWN_BYPASS=true
MAX_DRAWDOWN=5
MAX_DAILY_LOSS=1
MAX_WEEKLY_LOSS=5
MAX_MONTHLY_LOSS=5
