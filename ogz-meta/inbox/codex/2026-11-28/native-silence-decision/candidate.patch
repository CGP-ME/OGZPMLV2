+  async _inspectNativeSilence(symbol, timeframe, broker, signal) {
+    const context = this.getSymbolTimeframeContext(symbol, timeframe);
+    const native = context.lastNativeData;
+    const scope = this.getCandleScopeEnvelope({ timeframe });
+    const currentOwner = native?.sessionRouterEpoch === this.sessionRouter.activeCallbackEpoch
+      && native?.brokerId === scope.brokerId && native?.accountId === scope.accountId;
+    const anchor = currentOwner ? native.candleStartTimeMs
+      : context.priceHistory.findLast(candle => candle.etime <= this.livenessWatchdogStartedAt)?.t;
+    // Do not convict a delivery while its normal native lateness window is open.
+    const range = { start: anchor, end: Date.now() - this.config.dataFeed.staleDataMaxAgeMs };
+    const evidence = { symbol, timeframe, range, confirmed: false };
+    if (!Number.isSafeInteger(anchor)) return { ...evidence, status: 'unverified', reason: 'native_anchor_unavailable' };
+    let result;
+    try {
+      result = await broker.getCandles(symbol, timeframe, this.config.dataFeed.livenessBackfillLimit, range, { signal });
+    } catch (error) {
+      return { ...evidence, status: 'unverified', reason: 'history_request_failed', error: error.message };
+    }
+    if (signal.aborted) return { ...evidence, status: 'unverified', reason: 'history_request_cancelled' };
+    // Delivery that resumes during the query retires this suspicion. REST never
+    // advances the native clock or becomes a second entry stream.
+    if (context.lastNativeData !== native) return { ...evidence, status: 'native_resumed' };
+    const coverage = result?.coverage;
+    evidence.coverage = coverage;
+    if (coverage?.start !== range.start || coverage?.end !== range.end || coverage.complete !== true) {
+      return { ...evidence, status: 'unverified', reason: coverage?.reason || 'history_coverage_unavailable' };
+    }
+    const timeframeMs = this.candleAggregator.getIntervalMs(timeframe);
+    const candles = Array.isArray(result.candles)
+      ? result.candles.map(candle => this._normalizeHydrationCandle(candle, symbol, timeframe, timeframeMs)) : [];
+    if (!candles.length || candles.some(candle => !candle) || !candles.some(candle => candle.t === anchor)) {
+      return { ...evidence, status: 'unverified', reason: 'history_anchor_or_candles_invalid' };
+    }
+    const missed = candles.filter(candle => candle.t > anchor && candle.etime < range.end
+      && candle.etime > this.livenessWatchdogStartedAt);
+    return { ...evidence, status: missed.length ? 'native_delivery_missing' : 'verified_quiet',
+      confirmed: missed.length > 0, missedCandleStarts: missed.map(candle => candle.t) };
+  }
