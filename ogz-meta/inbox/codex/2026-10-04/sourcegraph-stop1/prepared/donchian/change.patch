+function donchianNumericReplacementProblem(config) {
+  const cfg = config.strategies?.DonchianBreakout;
+  for (const key of ['entryPeriod', 'atrPeriod', 'atrStopMult', 'trailChannelBars']) {
+    const problem = { reason: 'invalid_donchian_numeric_setting', path: `strategies.DonchianBreakout.${key}` };
+    const raw = cfg?.[key];
+    if ((typeof raw !== 'number' && typeof raw !== 'string')
+        || (typeof raw === 'string' && raw.trim() === '')) return problem;
+    const value = Number(raw);
+    if (!Number.isFinite(value) || value <= 0) return problem;
+    if ((key === 'entryPeriod' || key === 'atrPeriod') && !Number.isInteger(value)) return problem;
+  }
+  return null;
+}
