[];\n    33\t  const events = [];\n    34\t  const parseErrors = [];\n    35\t  for (const line of String(stdout).split('\\n').filter(Boolean)) {\n    36\t    try { frames.push(JSON.parse(line)); } catch { parseErrors.push('invalid_exec_jsonl'); }\n    37\t  }\n    38\t  for (const line of String(stderr).split('\\n')) {\n    39\t    const offset = line.indexOf('SSE event: ');\n    40\t    if (offset < 0) continue;\n    41\t    const payload = line.slice(offset + 'SSE event: '.length);\n    42\t    if (payload === '[DONE]') continue;\n    43\t    try { events.push(JSON.parse(payload)); } catch { parseErrors.push('invalid_provider_sse'); }\n    44\t  }\n    45\t  const observations = events.filter(event => event.response).map(event => ({\n    46\t    event: event.type, responseId: event.response.id, model: event.response.model || null,\n    47\t  }));\n    48\t  const completed = events.filter(event => event.type === 'response.completed');\n    49\t  const models = [...new Set(observations.map(item => item.model).filter(Boolean))];\n    50\t  const identityVerified = completed.length > 0 && observations.every(item => item.model === requestedModel);\n    51\t  const calls = events.filter(event => event.type === 'response.output_item.done'\n    52\t    && ['function_call', 'custom_tool_call'].includes(event.item && event.item.type))\n    53\t    .map(event => ({ id: event.item.call_id, name: event.item.name,\n    54\t      arguments: event.item.arguments === undefined ? event.item.input : event.item.arguments,\n    55\t      status: 'requested' }));\n    56\t  const catalogs = events.filter(event => Array.isArray(event.response?.tools));\n    57\t  const names = (tool, prefix = '') => tool.type === 'namespace'\n    58\t    ? (tool.tools || []).flatMap(child => names(child, prefix + tool.name + '.'))\n    59\t    : (tool.name ? [prefix + tool.name] : []);\n    60\t  const available = [...new Set(catalogs.flatMap(event => event.response.tools.flatMap(tool => names(tool))))];\n    61\t  const tools = {\n    62\t    enabled: true,\n    63\t    available,\n    64\t    availability_status: catalogs.length ? 'provider_response_catalog' : '[REDACTED]',\n    65\t    calls,\n    66\t    total: calls.length,\n    67\t    succeeded: null,\n    68\t    failed: null,\n    69\t    outcome_status: 'see_exec_events_and_raw_tapes',\n    70\t    execution_events: frames.filter(frame => frame.item && frame.item.type !== 'agent_message'),\n    71\t  };\n    72\t  const answer = frames.filter(frame => frame.type === 'item.completed' && frame.item && frame.item.type === 'agent_message')\n    73\t    .map(frame => frame.item.text).at(-1) || '';\n    74\t  const complete = frames.some(frame => frame.type === 'turn.completed');\n    75\t  return { frames, events, parseErrors, observations, models, completed, identityVerified, tools, answer, complete };\n    76\t}\n    77\t\n    78\tclass CodexChallengerClient {\n    79\t  constructor(options) {\n    80\t    Object.assign(this, options);\n    81\t    this.providerName = 'codex-subscription';\n    82\t    this.requestCount = 0;\n    83\t    this.invoke = options.invoke || invoke;\n    84\t    this.initialized = false;\n    85\t  }\n    86\t\n    87\t  async initialize() {\n    88\t    if (this.initialized) return;\n    89\t    const realpath = fs.realpathSync(CODEX_LAUNCHER);\n    90\t    const packagePath = path.resolve(path.dirname(realpath), '../package.json');\n    91\t    const packageInfo = JSON.parse(fs.readFileSync(packagePath, 'utf8'));\n    92\t    const version = await this.invoke(CODEX_LAUNCHER, ['--version'], this.execOptions());\n    93\t    const auth = await this.invoke(CODEX_LAUNCHER, ['login', 'status'], this.execOptions());\n    94\t    this.executableTrust = {\n    95\t      trusted: packageInfo.name === '@openai/codex' && !version.error\n    96\t        && String(version.stdout).trim() === `codex-cli ${packageInfo.version}`,\n    97\t      realpath, version: String(version.stdout).trim(), package: packageInfo.name,\n    98\t    };\n    99\t    this.authStatus = { authenticated: !auth.error && /Logged in using ChatGPT/.test(String(auth.stdout) + String(auth.stderr)), method: 'chatgpt_subscription' };\n   100\t    this.initialization = { version, auth };\n   101\t    this.initialized = true;\n   102\t  }\n   103\t\n   104\t  execOptions() {\n   105\t    return { cwd: this.repoRoot, env: subscriptionEnv(), timeout: this.requestTimeoutMs,\n   106\t      maxBuffer: 64 * 1024 * 1024, encoding: 'utf8' };\n   107\t  }\n   108\t\n   109\t  async generateResponseWithMetadata(prompt) {\n   110\t    await this.initialize();\n   111\t    const started = Date.now();\n   112\t    const args = ['exec', '--ignore-user-config', '--ephemeral', '--skip-git-repo-check',\n   113\t      '--sandbox', 'read-only', '--json', '--model', this.model, '--cd', this.repoRoot,\n   114\t      '-c', 'approval_policy=\"never\"', '-c', 'forced_login_method=\"chatgpt\"',\n   115\t      '-c', 'model_provider=\"panel-subscription\"',\n   116\t      '-c', 'model_providers.panel-subscription.name=\"ChatGPT subscription\"',\n   117\t      '-c', `model_providers.panel-subscription.base_url=\"${SUBSCRIPTION_ENDPOINT}\"`,\n   118\t      '-c', 'model_providers.panel-subscription.wire_api=\"responses\"',\n   119\t      '-c', 'model_providers.panel-subscription.requires_openai_auth=true',\n   120\t      '-c', 'model_providers.panel-subscription.supports_websockets=false',\n   121\t      '-c', `developer_instructions=${JSON.stringify(this.systemPrompt.replace('You do not have repo tools in this review pass.',\n   122\t        'Use the available tools for read-only evidence inspection in the supplied working directory; it is the selected source snapshot when a review ref is pinned. Do not substitute the parent checkout. Do not edit files, call other reviewers, or change runtime state.'))}`,\n   123\t      '-'];\n   124\t    const result = await this.invoke(CODEX_LAUNCHER, args, { ...this.execOptions(), input: prompt });\n   125\t    this.requestCount += 1;\n   126\t    const parsed = parseCodexTapes(result.stdout, result.stderr, this.model);\n   127\t    const termination = result.error ? 'error' : (parsed.complete ? 'stop' : 'incomplete');\n   128\t    const metadata = {\n   129\t      provider: this.providerName, requestedModel: this.model,\n   130\t      appliedModel: parsed.models.at(-1) || null, appliedModels: parsed.models,\n   131\t      verdictModels: parsed.completed.map(event => event.response.model),\n   132\t      modelObservations: parsed.observations, modelTransitions: [],\n   133\t      identityPosture: { status: parsed.identityVerified ? 'verified' : 'identity_conflict',\n   134\t        authority: 'provider_response_sse', reason: parsed.identityVerified ? 'every_response_model_matches' : '[REDACTED]' },\n   135\t      startedAt: new Date(started).toISOString(), finishedAt: new Date().toISOString(), latencyMs: Date.now() - started,\n   136\t      exitCode: result.error ? result.error.code : 0, termination,\n   137\t      stoppedBecause: result.error ? result.error.message : termination,\n   138\t      providerError: result.error ? { name: result.error.name, message: result.error.message,\n   139\t        code: result.error.code || null, signal: result.error.signal || null, killed: result.error.killed === true } : null,\n   140\t      parseStatus: parsed.parseErrors.length ? 'parse_errors' : (parsed.complete ? 'complete' : 'incomplete'), parseErrors: parsed.parseErrors,\n   141\t      initialization: this.initialization || null,\n   142\t      usage: parsed.frames.findLast(frame => frame.type === 'turn.completed')?.usage || null,\n   143\t      rawResponse: Buffer.from(result.stdout || ''), rawError: Buffer.from(result.stderr || ''),\n   144\t      providerFrames: parsed.events, toolsAvailable: parsed.tools.available, tools: parsed.tools,\n   145\t      providerErrors: parsed.frames.filter(frame => frame.type === 'error' || frame.type === 'turn.failed'),\n   146\t      authStatus: this.authStatus, executableTrust: this.executableTrust,\n   147\t      invocation: { executable: CODEX_LAUNCHER, args, subscriptionEndpoint: SUBSCRIPTION_ENDPOINT,\n   148\t        configuredMaxTokens: this.maxTokens, outputTokenLimitEnforced: false },\n   149\t    };\n   150\t    // Preserve the answer and every diagnostic. Existing panel routing owns seat handling.\n   151\t    return { answer: parsed.answer, metadata };\n   152\t  }\n   153\t}\n   154\t\n   155\tmodule.exports = { CodexChallengerClient, parseCodexTapes, subscriptionEnv };\ndiff --git a/mercury.config.json b/mercury.config.json\nindex f4c6f8a8..5c93297f 100644\n--- a/mercury.config.json\n+++ b/mercury.config.json\n@@ -139,11 +139,11 @@\n   },\n   \"consensus\": {\n     \"defaultEnabled\": false,\n-    \"provider\": \"claude-code\",\n-    \"model\": \"fable\",\n-    \"emergencyModel\": \"opus\",\n+    \"provider\": \"codex-subscription\",\n+    \"model\": \"gpt-6-astra\",\n+    \"emergencyModel\": null,\n     \"apiKeyEnv\": null,\n-    \"permissionMode\": \"dontAsk\",\n+    \"permissionMode\": \"read-only\",\n     \"clientMaxTokens\": 2000,\n     \"clientMinTokens\": 200,\n     \"requestTimeoutMs\": 300000,\ndiff --git a/trai_brain/mercury-bridge/config.js b/trai_brain/mercury-bridge/config.js\nindex c8afd48d..3d56ebaf 100644\n--- a/trai_brain/mercury-bridge/config.js\n+++ b/trai_brain/mercury-bridge/config.js\n@@ -446,7 +446,7 @@ if (MERCURY_LLM_PROVIDER === 'ollama') {\n   throw new Error('llm.apiKeyEnv is required for non-local Mercury LLM providers');\n }\n \n-// ─── Fable adversarial review client ─────────────────────────\n+// ─── Astra adversarial review client ─────────────────────────\n const CONSENSUS_DEFAULT_ENABLED = optionalBoolean(MERCURY_CONFIG, 'consensus.defaultEnabled', false);\n const adversarialReviewEnv = optionalEnvBoolean('MERCURY_ADVERSARIAL_REVIEW');\n const [REDACTED] = adversarialReviewEnv == null\n@@ -456,37 +456,36 @@ const ADVERSARIAL_REVIEW_MAX_RECHECKS = optionalNumber(MERCURY_CONFIG, 'adversar\n const CONSENSUS_PROVIDER = requiredString(MERCURY_CONFIG, 'consensus.provider').toLowerCase();\n const CONSENSUS_BASE_URL = optionalString(MERCURY_CONFIG, 'consensus.baseUrl');\n const CONSENSUS_MODEL = requiredString(MERCURY_CONFIG, 'consensus.model').toLowerCase();\n-const CONSENSUS_EMERGENCY_MODEL = requiredString(MERCURY_CONFIG, 'consensus.emergencyModel').toLowerCase();\n+const CONSENSUS_EMERGENCY_MODEL = optionalString(MERCURY_CONFIG, 'consensus.emergencyModel');\n const CONSENSUS_API_KEY_ENV = optionalString(MERCURY_CONFIG, 'consensus.apiKeyEnv');\n-const CONSENSUS_PERMISSION_MODE = optionalString(MERCURY_CONFIG, 'consensus.permissionMode') || 'dontAsk';\n+const CONSENSUS_PERMISSION_MODE = optionalString(MERCURY_CONFIG, 'consensus.permissionMode') || 'read-only';\n const CONSENSUS_CLIENT_MAX_TOKENS = optionalNumber(MERCURY_CONFIG, 'consensus.clientMaxTokens', 2000, { integer: true, min: 1 });\n const CONSENSUS_CLIENT_MIN_TOKENS = optionalNumber(MERCURY_CONFIG, 'consensus.clientMinTokens', 0, { integer: true, min: 0 });\n const CONSENSUS_REQUEST_TIMEOUT_MS = optionalNumber(MERCURY_CONFIG, 'consensus.requestTimeoutMs', 300000, { integer: true, min: 1000 });\n const CONSENSUS_TEMPERATURE = optionalNumber(MERCURY_CONFIG, 'consensus.temperature', 0, { min: 0 });\n const CONSENSUS_OPENAI_EXTRA_BODY = optionalPlainObject(MERCURY_CONFIG, 'consensus.openaiExtraBody', {});\n const CONSENSUS_SYSTEM_PROMPT = optionalText(MERCURY_CONFIG, 'consensus.systemPrompt', [\n-  'You are Fable, the consensus collaborator for OGZPrime Mercury reviews.',\n+  'You are the challenger, the consensus collaborator for OGZPrime Mercury reviews.',\n   'Evaluate Mercury evidence. Do not invent repo facts or file:line citations.',\n ].join('\\n'));\n \n-if (CONSENSUS_PROVIDER !== 'claude-code') {\n-  throw new Error('consensus.provider must be claude-code; Kimi cannot satisfy the challenger role');\n+if (CONSENSUS_PROVIDER !