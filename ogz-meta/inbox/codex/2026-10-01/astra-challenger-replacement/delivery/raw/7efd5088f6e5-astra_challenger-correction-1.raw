{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport subprocess\nT='df34112529a6e1db26a79312ca2e3402ccb14334'\nfor p in ['test/mercury-astra-challenger.test.js','test/mercury-provider-preflight.test.js']:\n print('\\\\n'+p)\n for n,l in enumerate(subprocess.check_output(['git','show',T+':'+p],text=True).splitlines(),1): print(f'{n}: {l}')\nPY\"","aggregated_output":"\ntest/mercury-astra-challenger.test.js\n1: 'use strict';\n2: const { CodexChallengerClient, parseCodexTapes, subscriptionEnv } = require('../trai_brain/mercury-bridge/codex-challenger');\n3: const { REVIEWER_REGISTRY, canAttachFinalReview, reportedPanelDecision } = require('../trai_brain/mercury-bridge/reviewer-panel');\n4: const { runAstraAdversarialReview, executePromptOnlyStage } = require('../trai_brain/mercury-bridge/adversarial-review');\n5: const { checkClient } = require('../trai_brain/mercury-bridge/provider-preflight');\n6: const crypto = require('crypto');\n7: const model='gpt-6-astra';\n8: function tapes(applied=model) {\n9:  const stdout=[{type:'item.completed',item:{type:'agent_message',text:'VERDICT: pass\\nCONSENSUS_BLOCKING: no'}},{type:'turn.completed',usage:{input_tokens:10,output_tokens:5}}].map(JSON.stringify).join('\\n');\n10:  const stderr='TRACE codex_api::sse::responses: SSE event: '+JSON.stringify({type:'response.completed',response:{id:'resp_fixture',model:applied,status:'completed'}})+'\\n';\n11:  return {stdout,stderr};\n12: }\n13: function client(result=tapes()) {\n14:  const c=new CodexChallengerClient({model,repoRoot:process.cwd(),systemPrompt:'Read only.',maxTokens:2000,requestTimeoutMs:1000,invoke:jest.fn(async()=>result)});\n15:  c.initialized=true;c.executableTrust={trusted:true};c.authStatus={authenticated:true};return c;\n16: }\n17: \n18: test('registry replaces only challenger; Kimi attachment binds exact Astra answer and order',()=>{\n19:  expect(REVIEWER_REGISTRY.map(x=>x.id)).toEqual(['mercury','astra','kimi']);\n20:  const a={status:'succeeded',sequence:1,answer:'answer'};\n21:  const k={status:'succeeded',sequence:2,inputDependencies:[{id:'astra',sequence:1,answerSha256:crypto.createHash('sha256').update(a.answer).digest('hex')}]};\n22:  expect(canAttachFinalReview(a,k)).toBe(true);\n23:  expect(canAttachFinalReview({...a,answer:'changed'},k)).toBe(false);\n24:  expect(reportedPanelDecision({seats:[{id:'mercury',status:'succeeded',answer:'pass',parsed:{verdict:'pass'}},{id:'astra',status:'failed'}]}).verdict).toBe('review_incomplete');\n25: });\n26: \n27: test('subscription environment removes API credentials and uses response-only trace',()=>{\n28:  const env=subscriptionEnv({OPENAI_API_KEY:'[REDACTED]',CODEX_API_KEY:'[REDACTED]',OPENAI_BASE_URL:'https://other',NODE_OPTIONS:'injection'});\n29:  expect(env.OPENAI_API_KEY).toBeUndefined();expect(env.CODEX_API_KEY).toBeUndefined();expect(env.OPENAI_BASE_URL).toBeUndefined();expect(env.NODE_OPTIONS).toBeUndefined();\n30:  expect(env.RUST_LOG).toBe('codex_api::sse::responses=trace');\n31: });\n32: \n33: test.each([null,'gpt-5.6-sol','claude-fable-5'])('provider identity %s is recorded without discarding the answer',async applied=>{\n34:  const c=client(tapes(applied));const r=await c.generateResponseWithMetadata('review');\n35:  expect(r.answer).toContain('VERDICT: pass');expect(r.metadata.identityPosture.status).toBe('identity_conflict');expect(c.invoke).toHaveBeenCalledTimes(1);\n36: });\n37: \n38: test('actual provider identity, completion and complete tapes qualify; CLI config alone does not',async()=>{\n39:  const c=client();const r=await c.generateResponseWithMetadata('review');\n40:  expect(r.answer).toContain('VERDICT: pass');expect(r.metadata.appliedModel).toBe(model);expect(r.metadata.rawError.toString()).toContain('response.completed');\n41:  const args=c.invoke.mock.calls[0][1];expect(args).toContain('forced_login_method=\"chatgpt\"');expect(args).toContain('read-only');expect(args.join(' ')).not.toMatch(/claude|api_key/);\n42:  const absent=await client({...tapes(),stderr:''}).generateResponseWithMetadata('review');expect(absent.answer).toContain('VERDICT: pass');expect(absent.metadata.identityPosture.status).toBe('identity_conflict');\n43: });\n44: \n45: test.each(['timeout','malformed','incomplete'])('failure %s preserves tapes without fallback',async kind=>{\n46:  const raw=tapes();if(kind==='timeout')raw.error=Object.assign(new Error('timed out'),{code:'ETIMEDOUT'});\n47:  if(kind==='malformed')raw.stderr+='TRACE SSE event: {broken\\n';\n48:  if(kind==='incomplete')raw.stdout=raw.stdout.split('\\n')[0];\n49:  const c=client(raw),r=await c.generateResponseWithMetadata('review');expect(r.answer).toContain('VERDICT: pass');expect(r.metadata.rawResponse.toString()).toBe(raw.stdout);expect(c.invoke).toHaveBeenCalledTimes(1);\n50: });\n51: \n52: test('tool requests and command outcomes are retained independently of verdict text',()=>{\n53:  const raw=tapes();raw.stderr+='TRACE SSE event: '+JSON.stringify({type:'response.output_item.done',item:{type:'function_call',name:'exec',call_id:'call1',arguments:'read source'}})+'\\n';\n54:  raw.stdout+='\\n'+JSON.stringify({type:'item.completed',item:{type:'command_execution',command:'rg x file.js',exit_code:0,status:'completed',aggregated_output:'evidence'}});\n55:  const p=parseCodexTapes(raw.stdout,raw.stderr,model);expect(p.tools.enabled).toBe(true);expect(p.tools.calls[0].name).toBe('exec');expect(p.tools.execution_events[0].item.aggregated_output).toBe('evidence');\n56: });\n57: \n58: test('identity conflict retains the answer and raw receipts without a replacement call',async()=>{\n59:  const persistRaw=jest.fn((role,attempt,bytes)=>({role,attempt,bytes:bytes.length}));\n60:  const c=client(tapes('wrong'));\n61:  const r=await runAstraAdversarialReview({query:'Review this change.',mercuryResult:{answer:'Evidence absent.'},createAstraClient:()=>c,persistRaw});\n62:  expect(r.ok).toBe(true);expect(r.answer).toContain('VERDICT: pass');expect(r.identityPosture.status).toBe('identity_conflict');expect(c.invoke).toHaveBeenCalledTimes(1);expect(persistRaw).toHaveBeenCalled();\n63:  const preflight=await checkClient('astra_challenger',()=>client(tapes('wrong')));expect(preflight.identityPosture.status).toBe('identity_conflict');expect(preflight.attemptReceipt.applied_model).toBe('wrong');\n64: });\n65: \n66: test('Kimi still rejects exposed tools; Astra keeps tool-enabled receipts',async()=>{\n67:  const metadata={provider:'codex-subscription',requestedModel:model,appliedModel:model,toolsAvailable:['read'],tools:{enabled:true,calls:[{name:'exec'}]},identityPosture:{status:'verified'},rawResponse:Buffer.from('raw')};\n68:  const factory=()=>({initialize:async()=>{},generateResponseWithMetadata:async()=>({ok:true,answer:'VERDICT: pass',metadata})});\n69:  const input={prompt:'review',createClient:factory,persistRaw:()=>({path:'fixture'}),attemptNumber:1};\n70:  await expect(executePromptOnlyStage({...input,role:'kimi_tie_breaker'})).rejects.toThrow('prompt-only');\n71:  const result=await executePromptOnlyStage({...input,role:'astra_challenger'});expect(result.receipt.tools.enabled).toBe(true);\n72: });\n73: \n74: test('transport failure and partial answer survive on the stage receipt without a new throw',async()=>{\n75:  const raw={...tapes(),error:Object.assign(new Error('transport timed out'),{code:'ETIMEDOUT',killed:true})};\n76:  const stage=await executePromptOnlyStage({role:'astra_challenger',prompt:'review',createClient:()=>client(raw),persistRaw:(role,attempt,bytes)=>({role,size:bytes.length}),attemptNumber:1});\n77:  expect(stage.answer).toContain('VERDICT: pass');\n78:  expect(stage.receipt.status).toBe('failed');\n79:  expect(stage.receipt.termination).toBe('error');\n80:  expect(stage.receipt.provider_error.message).toBe('transport timed out');\n81:  expect(stage.receipt.raw_output.size).toBeGreaterThan(0);\n82:  expect(stage.receipt.raw_error.size).toBeGreaterThan(0);\n83: });\n84: \n85: test('identity-conflicted Astra does not stop the next selected seat',async()=>{\n86:  const {runReviewerPanel}=require('../trai_brain/mercury-bridge/reviewer-panel');\n87:  const visited=[];\n88:  const panel=await runReviewerPanel({selected:['astra','mercury'],isHardStop:()=>false,runSeat:async reviewer=>{\n89:   visited.push(reviewer.id);\n90:   if(reviewer.id==='astra'){\n91:    const r=await runAstraAdversarialReview({query:'review',mercuryResult:{answer:'Evidence absent.'},createAstraClient:()=>client(tapes('wrong')),persistRaw:()=>({path:'fixture'})});\n92:    return {answer:r.answer,identityConflict:r.identityPosture.status==='identity_conflict'};\n93:   }\n94:   return {answer:'Mercury answer'};\n95:  }});\n96:  expect(visited).toEqual(['astra','mercury']);\n97:  expect(panel.seats[0].answer).toContain('VERDICT: pass');\n98:  expect(panel.seats[1].answer).toBe('Mercury answer');\n99:  expect(panel.diagnostics.issues).toContain('identity_conflict');\n100: });\n101: \n102: test('selected source snapshot reaches the Astra tool working directory',async()=>{\n103:  const snapshot='/selected/review/source';let used;\n104:  await runAstraAdversarialReview({query:'review',reviewRoot:snapshot,mercuryResult:{answer:'Prior evidence'},persistRaw:()=>({path:'fixture'}),createAstraClient:options=>{\n105:   used=client();used.repoRoot=options.repoRoot;return used;\n106:  }});\n107:  const args=used.invoke.mock.calls[0][1];expect(args[args.indexOf('--cd')+1]).toBe(snapshot);\n108:  expect(used.invoke.mock.calls[0][2].cwd).toBe(snapshot);\n109: });\n110: \n111: test('subscription quota errors and provider tool catalog are visible on the receipt',async()=>{\n112:  const raw=tapes();raw.stdout+='\\n'+JSON.stringify({type:'error',message:'Usage limit reached'})+'\\n'+JSON.stringify({type:'turn.failed',error:{message:'Usage limit reached'}});\n113:  raw.stderr+='TRACE SSE event: '+JSON.stringify({type:'response.created',response:{id:'resp_tools',model,tools:[{type:'namespace',name:'functions',tools:[{type:'custom',name:'exec'}]}]}})+'\\n';\n114:  raw.error=Object.assign(new Error('Codex exited'),{code:1});\n115:  const stage=await executePromptOnlyStage({role:'astra_challenger',prompt:'review',createClient:()=>client(raw),persistRaw:()=>({path:'fixture'}),attemptNumber:1});\n116:  expect(stage.answer).toContain('VERDICT: pass');\n117:  expect(stage.receipt.provider_errors).toContainEqual({type:'error',message:'Usage limit reached'});\n118:  expect(stage.receipt.tools.available).toEqual(['functions.exec']);\n119:  expect(stage.receipt.tools.availability_status).toBe('provider_response_catalog');\n120: });\n\ntest/mercury-provider-preflight.test.js\n1: 'use strict';\n2: \n3: const fs = require('fs');\n4: const os = require('os');\n5: const path = require('path');\n6: \n7: const {\n8:   classifyProviderError,\n9:   sanitizeProviderMessage,\n10:   checkClient,\n11:   runProviderPreflight,\n12: } = require('../trai_brain/mercury-bridge/provider-preflight');\n13: \n14: function fakeClient({ provider, model, initialize }) {\n15:   return {\n16:     providerName: provider,\n17:     model,\n18:     requestCount: 0,\n19:     initialize: jest.fn(async function doInitialize() {\n20:       await initialize();\n21:       this.requestCount += 1;\n22:     }),\n23:   };\n24: }\n25: \n26: function trustedFableMetadata(overrides = {}) {\n27:   return {\n28:     provider: 'claude-code',\n29:     requestedModel: 'fable',\n30:     appliedModel: 'claude-fable-5',\n31:     appliedModels: ['claude-fable-5'],\n32:     authStatus: { authMethod: 'claude.ai', apiProvider: 'firstParty', subscriptionType: 'max' },\n33:     executableTrust: {\n34:       trusted: true,\n35:       realpath: '/usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe',\n36:       version: '2.1.236',\n37:     },\n38:     ...overrides,\n39:   };\n40: }\n41: \n42: describe('Mercury provider preflight', () => {\n43:   test.each(['error', 'incomplete'])('reports %s transport as unavailable and retains its tapes', async termination => {\n44:     const metadata = {\n45:       provider: 'codex-subscription', requestedModel: 'gpt-6-astra',\n46:       termination, providerErrors: [{ type: 'error', message: 'usage exhausted' }],\n47:       rawResponse: Buffer.from('partial answer'), rawError: Buffer.from('usage exhausted'),\n48:     };\n49:     const result = await checkClient('astra_challenger', () => ({\n50:       providerName: 'codex-subscription', model: 'gpt-6-astra',\n51:       initialize: async () => {},\n52:       generateResponseWithMetadata: async () => ({ answer: 'partial answer', metadata }),\n53:     }), { repoRoot: tmpRoot, runId: 'transport-reporting', attempt: 1 });\n54:     expect(result.ok).toBe(false);\n55:     expect(result.attemptReceipt.status).toBe('failed');\n56:     expect(result.attemptReceipt.provider_errors).toEqual(metadata.providerErrors);\n57:     expect(fs.readFileSync(path.join(tmpRoot, result.attemptReceipt.raw_output.path), 'utf8')).toBe('partial answer');\n58:     expect(fs.readFileSync(path.join(tmpRoot, result.attemptReceipt.raw_error.path), 'utf8')).toBe('usage exhausted');\n59:   });\n60: \n61:   let tmpRoot;\n62: \n63:   beforeEach(() => {\n64:     tmpRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'mercury-provider-preflight-'));\n65:   });\n66: \n67:   afterEach(() => {\n68:     fs.rmSync(tmpRoot, { recursive: true, force: true });\n69:   });\n70: \n71:   test('classifies provider access failures into operator-action buckets', () => {\n72:     expect(classifyProviderError(new Error('HTTP 402: free_tier_quota_exceeded'))).toBe('quota_or_billing');\n73:     expect(classifyProviderError(new Error('HTTP 429: insufficient balance'))).toBe('quota_or_billing');\n74:     expect(classifyProviderError(new Error('HTTP 403: this model requires a subscription'))).toBe('quota_or_billing');\n75:     expect(classifyProviderError(new Error('HTTP 401: authentication_error invalid x-api-key'))).toBe('auth');\n76:     expect(classifyProviderError(new Error('model not found'))).toBe('model');\n77:     expect(classifyProviderError(new Error('ETIMEDOUT'))).toBe('network');\n78:     expect(classifyProviderError(new Error('weird provider failure'))).toBe('unknown');\n79:   });\n80: \n81:   test('redacts provider request ids from preflight error messages', () => {\n82:     expect(sanitizeProviderMessage('HTTP 401: {\"request_id\":\"req_secret\"}'))\n83:       .toBe('HTTP 401: {\"request_id\":\"[REDACTED]\"}');\n84:     expect(sanitizeProviderMessage('HTTP 429: org-abc123 <ak-secret-handle> insufficient balance'))\n85:       .toBe('HTTP 429: org-[REDACTED] <account-[REDACTED]> insufficient balance');\n86:     expect(sanitizeProviderMessage('HTTP 403: upgrade for access (ref: [REDACTED])'))\n87:       .toBe('HTTP 403: upgrade for access (ref: [REDACTED])');\n88:   });\n89: \n90:   test('preflight returns ok only when Mercury and Astra both warm up', async () => {\n91:     const result = await runProviderPreflight({\n92:       createMercuryClient: () => fakeClient({\n93:         provider: 'mercury',\n94:         model: 'mercury-2',\n95:         initialize: async () => {},\n96:       }),\n97:       createAstraClient: () => fakeClient({\n98:         provider: 'claude',\n99:         model: 'fable',\n100:         initialize: async () => {},\n101:       }),\n102:       createKimiClient: () => fakeClient({\n103:         provider: 'openai',\n104:         model: 'kimi-k3',\n105:         initialize: async () => {},\n106:       }),\n107:     });\n108: \n109:     expect(result).toMatchObject({\n110:       ok: true,\n111:       challengerReady: true,\n112:       tieBreakerReady: true,\n113:       checks: [\n114:         {\n115:           label: 'mercury',\n116:           ok: true,\n117:           provider: 'mercury',\n118:           model: 'mercury-2',\n119:           requests: 1,\n120:         },\n121:         {\n122:           label: 'astra_challenger',\n123:           ok: true,\n124:           provider: 'claude',\n125:           model: 'fable',\n126:           requests: 1,\n127:         },\n128:         {\n129:           label: 'kimi_tie_breaker',\n130:           ok: true,\n131:           provider: 'openai',\n132:           model: 'kimi-k3',\n133:           requests: 1,\n134:         },\n135:       ],\n136:     });\n137:   });\n138: \n139:   test('preflight preserves individual provider failures without hiding the second check', async () => {\n140:     const result = await runProviderPreflight({\n141:       createMercuryClient: () => fakeClient({\n142:         provider: 'mercury',\n143:         model: 'mercury-2',\n144:         initialize: async () => {\n145:           throw new Error('HTTP 402: free_tier_quota_exceeded');\n146:         },\n147:       }),\n148:       createAstraClient: () => fakeClient({\n149:         provider: 'claude',\n150:         model: 'fable',\n151:         initialize: async () => {\n152:           throw new Error('HTTP 401: authentication_error invalid x-api-key');\n153:         },\n154:       }),\n155:       createKimiClient: () => fakeClient({\n156:         provider: 'openai',\n157:         model: 'kimi-k3',\n158:         initialize: async () => {},\n159:       }),\n160:     });\n161: \n162:     expect(result.ok).toBe(false);\n163:     expect(result.checks).toMatchObject([\n164:       {\n165:         label: 'mercury',\n166:         ok: false,\n167:         provider: 'mercury',\n168:         model: 'mercury-2',\n169:         error: { category: 'quota_or_billing' },\n170:       },\n171:       {\n172:         label: 'astra_challenger',\n173:         ok: false,\n174:         provider: 'claude',\n175:         model: 'fable',\n176:         error: { category: 'auth' },\n177:       },\n178:       {\n179:         label: 'kimi_tie_breaker',\n180:         ok: true,\n181:         provider: 'openai',\n182:         model: 'kimi-k3',\n183:       },\n184:     ]);\n185:     expect(result.challengerReady).toBe(false);\n186:     expect(result.tieBreakerReady).toBe(true);\n187:   });\n188: \n189:   test('Kimi readiness never satisfies challenger readiness', async () => {\n190:     const result = await runProviderPreflight({\n191:       createMercuryClient: () => fakeClient({ provider: 'mercury', model: 'mercury-2', initialize: async () => {} }),\n192:       createAstraClient: () => fakeClient({\n193:         provider: 'claude-code', model: 'fable', initialize: async () => { throw new Error('auth failed'); },\n194:       }),\n195:       createKimiClient: () => fakeClient({ provider: 'openai', model: 'kimi-k3', initialize: async () => {} }),\n196:     });\n197:     expect(result).toMatchObject({ ok: false, challengerReady: false, tieBreakerReady: true });\n198:   });\n199: \n200:   // Retired Claude fallback contract; Astra no-fallback coverage is in mercury-astra-challenger.test.js.\n201: \n202:   test('preflight stamps identity conflict and continues without misreporting pipeline Opus fallback', async () => {\n203:     const opusFactory = jest.fn(() => fakeClient({ provider: 'claude-code', model: 'opus', initialize: async () => {} }));\n204:     const result = await runProviderPreflight({\n205:       createMercuryClient: () => fakeClient({ provider: 'mercury', model: 'mercury-2', initialize: async () => {} }),\n206:       createAstraClient: () => ({\n207:         providerName: 'claude-code', model: 'fable', requestCount: 0,\n208:         initialize: jest.fn(async () => {}),\n209:         generateResponseWithMetadata: jest.fn(async () => ({\n210:           answer: 'PROVIDER_OK',\n211:           metadata: trustedFableMetadata({\n212:             appliedModels: ['claude-fable-5', 'claude-sonnet-4-5'],\n213:             verdictModels: ['claude-sonnet-4-5'],\n214:             identityPosture: {\n215:               status: 'identity_conflict', authority: 'unverified', reason: 'undocumented_model_mismatch',\n216:               requested_model: 'fable', applied_models: ['claude-fable-5', 'claude-sonnet-4-5'],\n217:               verdict_models: ['claude-sonnet-4-5'], undocumented_models: ['claude-sonnet-4-5'],\n218:               observations: [], transitions: [],\n219:             },\n220:           }),\n221:         })),\n222:       }),\n223:       createOpusClient: opusFactory,\n224:       createKimiClient: () => fakeClient({ provider: 'openai', model: 'kimi-k3', initialize: async () => {} }),\n225:     });\n226: \n227:     expect(result).toMatchObject({ ok: true, challengerReady: true });\n228:     expect(result.checks[1]).toMatchObject({\n229:       ok: true,\n230:       identityPosture: { status: 'identity_conflict', authority: 'unverified' },\n231:       attemptReceipt: {\n232:         status: 'succeeded',\n233:         applied_models: ['claude-fable-5', 'claude-sonnet-4-5'],\n234:         verdict_models: ['claude-sonnet-4-5'],\n235:         identity_posture: {\n236:           status: 'identity_conflict',\n237:           authority: 'unverified',\n238:           reason: 'undocumented_model_mismatch',\n239:         },\n240:       },\n241:     });\n242:     expect(opusFactory).not.toHaveBeenCalled();\n243:     expect(result.checks.map(check => check.label))\n244:       .toEqual(['mercury', 'astra_challenger', 'kimi_tie_breaker']);\n245:   });\n246: \n247:   test('preflight cannot route around a genuinely untrusted Claude executable', async () => {\n248:     const trustFailure = new Error('Trusted first-party Claude Code executable was not found in a rooted system installation');\n249:     trustFailure.code = '[REDACTED]';\n250:     trustFailure.providerMetadata = trustedFableMetadata({\n251:       appliedModel: null,\n252:       appliedModels: [],\n253:       executableTrust: { trusted: false, failedCheck: 'rooted_system_launcher' },\n254:     });\n255:     const opusFactory = jest.fn();\n256:     const result = await runProviderPreflight({\n257:       createMercuryClient: () => fakeClient({ provider: 'mercury', model: 'mercury-2', initialize: async () => {} }),\n258:       createAstraClient: () => fakeClient({\n259:         provider: 'claude-code', model: 'fable', initialize: async () => { throw trustFailure; },\n260:       }),\n261:       createOpusClient: opusFactory,\n262:       createKimiClient: () => fakeClient({ provider: 'openai', model: 'kimi-k3', initialize: async () => {} }),\n263:     });\n264: \n265:     expect(result).toMatchObject({ ok: false, challengerReady: false });\n266:     expect(result.checks[1]).toMatchObject({\n267:       error: { code: '[REDACTED]' },\n268:       attemptReceipt: { executable_trust: { trusted: false, failedCheck: 'rooted_system_launcher' } },\n269:     });\n270:     expect(opusFactory).not.toHaveBeenCalled();\n271:   });\n272: \n273:   test('ambiguous nested Astra error fails loud and never invokes Opus during preflight', async () => {\n274:     const fableFailure = new Error('Astra malformed output');\n275:     fableFailure.providerMetadata = trustedFableMetadata({\n276:       providerFrames: [{ payload: { type: 'model_unavailable' } }],\n277:     });\n278:     const opusFactory = jest.fn();\n279:     const result = await runProviderPreflight({\n280:       createMercuryClient: () => fakeClient({ provider: 'mercury', model: 'mercury-2', initialize: async () => {} }),\n281:       createAstraClient: () => fakeClient({\n282:         provider: 'claude-code', model: 'fable', initialize: async () => { throw fableFailure; },\n283:       }),\n284:       createOpusClient: opusFactory,\n285:       createKimiClient: () => fakeClient({ provider: 'openai', model: 'kimi-k3', initialize: async () => {} }),\n286:     });\n287:     expect(opusFactory).not.toHaveBeenCalled();\n288:     expect(result).toMatchObject({ ok: false, challengerReady: false, tieBreakerReady: true });\n289:     expect(result.checks[1].fallback).toBeUndefined();\n290:   });\n291: \n292:   test('failed ambiguous Astra preflight writes complete schema-v2 and mode-0600 raw receipts without Opus', async () => {\n293:     const secr