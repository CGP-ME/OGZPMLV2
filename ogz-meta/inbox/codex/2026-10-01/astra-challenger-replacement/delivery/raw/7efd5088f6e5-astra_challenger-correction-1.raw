rted|uncited/.test(flag));\n1698:   console.log(`run checks:      ${runChecks.length} executed${assertsWithoutExecution ? ' — answer asserts outcomes with no execution backing' : ''}`);\n1699: \n1700:   const toolsInvoked = Array.isArray(entry.tools_invoked) ? entry.tools_invoked : [];\n1701:   const failedCalls = [];\n1702:   let totalCalls = 0;\n1703:   for (const tool of toolsInvoked) {\n1704:     totalCalls += tool.calls || 0;\n1705:     for (const call of tool.call_details || []) {\n1706:       if (call.status === 'failed') {\n1707:         const reason = call.result && call.result.error ? call.result.error : 'failed';\n1708:         failedCalls.push(`${tool.name}(${JSON.stringify(call.args)}): ${reason}`);\n1709:       }\n1710:     }\n1711:   }\n1712:   console.log(`tool failures:   ${failedCalls.length}/${totalCalls}`);\n1713:   failedCalls.forEach((line) => console.log(`  - ${line}`));\n1714:   if (result.toolTelemetry) {\n1715:     console.log(`tool calls:      ${formatToolTelemetry(result.toolTelemetry)}`);\n1716:   }\n1717: \n1718:   const sourceRefs = entry.source_refs || {};\n1719:   const blastFiles = Array.isArray(sourceRefs.auto_blast_radius_files) ? sourceRefs.auto_blast_radius_files.length : 0;\n1720:   const blastErrors = Array.isArray(sourceRefs.auto_blast_radius_errors) ? sourceRefs.auto_blast_radius_errors : [];\n1721:   console.log(`blast radius:    ${blastFiles} file(s) scanned, ${blastErrors.length} error(s)`);\n1722:   blastErrors.forEach((blastError) => console.log(`  - ${blastError.file}: ${blastError.error}`));\n1723:   const bundle = sourceRefs.current_change_evidence_bundle;\n1724:   if (bundle) {\n1725:     console.log(`AST evidence:    ${bundle.path}`);\n1726:     console.log(`evidence hash:   ${bundle.sha256} bytes=${bundle.bytes} sections=${bundle.section_count}`);\n1727:     console.log(`section manifest: ${bundle.manifest_path} sha256=${bundle.manifest_sha256}`);\n1728:   }\n1729: \n1730:   const candidateSet = entry.candidate_set;\n1731:   if (candidateSet) {\n1732:     console.log(`candidate set:   iteration=${candidateSet.captured_at_iteration} citations=${candidateSet.claimed_file_citations.length} answer-subset=${candidateSet.answer_citations_subset ? 'yes' : 'no'}`);\n1733:   }\n1734: \n1735:   const reviewEntry = entry.adversarial_review;\n1736:   if (!reviewEntry) {\n1737:     console.log('review layer:    not requested');\n1738:   } else if (reviewEntry.ok) {\n1739:     console.log(`review layer:    ok — ${reviewEntry.mode || 'adversarial_review'} verdict=${reviewEntry.effective_verdict || 'n/a'}`);\n1740:     if (reviewEntry.final_review) {\n1741:       const final = reviewEntry.final_review;\n1742:       const finalStatus = final.ok ? 'ok' : 'FAILED';\n1743:       console.log(`final adjud.:    ${finalStatus} — ${final.mode || 'kimi_final_adjudication'} verdict=${final.effective_verdict || 'n/a'}`);\n1744:       const sharedSupport = final.parsed && (final.parsed.consensus || final.parsed.sharedConclusion);\n1745:       if (sharedSupport) {\n1746:         console.log(`shared support:  ${sharedSupport}`);\n1747:       }\n1748:       if (final.parsed && final.parsed.contradictions && !/^none\\b/i.test(final.parsed.contradictions)) {\n1749:         console.log(`contradictions:  ${final.parsed.contradictions}`);\n1750:       }\n1751:       if (final.parsed && final.parsed.blindSpots && !/^none\\b/i.test(final.parsed.blindSpots)) {\n1752:         console.log(`blind spots:     ${final.parsed.blindSpots}`);\n1753:       }\n1754:     }\n1755:   } else {\n1756:     const reviewError = reviewEntry.error && reviewEntry.error.message\n1757:       ? reviewEntry.error.message\n1758:       : JSON.stringify(reviewEntry.error);\n1759:     console.log(`review layer:    FAILED — ${reviewError}`);\n1760:   }\n1761: \n1762:   const selfReportUnits = [\n1763:     ['mercury', entry.stages && entry.stages.mercury],\n1764:     [reviewEntry && reviewEntry.provider === 'codex-subscription' ? 'astra' : 'fabl