 safeRunId = safeRawPathPart(runId, 'run id');\n54:   const safeStage = safeRawPathPart(stage, 'stage');\n55:   if (!Number.isInteger(attempt) || attempt < 1) throw new Error('raw provider attempt must be a positive integer');\n56:   const relDir = path.join(RAW_PROVIDER_DIR, day, safeRunId).replace(/\\\\/g, '/');\n57:   const absDir = path.join(repoRoot, relDir);\n58:   fs.mkdirSync(absDir, { recursive: true, mode: 0o700 });\n59:   fs.chmodSync(absDir, 0o700);\n60:   const relPath = path.join(relDir, `${safeStage}-${attempt}.raw`).replace(/\\\\/g, '/');\n61:   const absPath = path.join(repoRoot, relPath);\n62:   const fd = fs.openSync(absPath, 'wx', 0o600);\n63:   try {\n64:     fs.writeFileSync(fd, rawBytes);\n65:     fs.fchmodSync(fd, 0o600);\n66:   } finally {\n67:     fs.closeSync(fd);\n68:   }\n69:   return {\n70:     path: relPath,\n71:     sha256: crypto.createHash('sha256').update(rawBytes).digest('hex'),\n72:     bytes: rawBytes.length,\n73:     mode: '0600',\n74:   };\n75: }\n76: \n77: // The current-change producer supplies the repository root and nonempty sections.\n78: // Keep the complete captured evidence beside the run's existing raw artifacts.\n79: function [REDACTED]({ repoRoot, runId, sections, reviewManifest = null, now = new Date() }) {\n80:   const day = isoTimestamp(now).slice(0, 10);\n81:   const safeRunId = safeRawPathPart(runId, 'run id');\n82:   const relDir = path.join(EVIDENCE_BUNDLE_DIR, day, safeRunId).replace(/\\\\/g, '/');\n83:   const absDir = path.join(repoRoot, relDir);\n560:     return 'cannot_verify';\n561:   }\n562:   if (!result || result.termination !== 'answer_given') return 'blocked';\n563: \n564:   return 'cannot_verify';\n565: }\n566: \n567: function parsedReviewClassification(parsed) {\n568:   if (!parsed || typeof parsed !== 'object') return null;\n569:   const clean = {};\n570:   for (const key of [\n571:     'consensus',\n572:     'contradictions',\n573:     'partial',\n574:     'unique',\n575:     'blindSpots',\n576:     'verdict',\n577:     'blocking',\n578:     'parseWarnings',\n579:     'disagreement',\n580:     'requiredRecheck',\n581:     'recheckPrompt',\n582:     'nextCheck',\n583:     'sharedConclusion',\n584:     'mercurySupported',\n585:     'astraSupported',\n586:     'fableSupported',\n587:     'kimiSupported',\n588:     'citedReasoning',\n589:     'candidateSet',\n590:     'astEvidence',\n591:     'inherited',\n592:     'fourthShapeClassifier',\n593:     'allegationClass',\n594:     'substantiveResolution',\n595:     'whatIExamined',\n596:     'didNotExamine',\n597:     'assumed',\n598:   ]) {\n599:     if (Object.prototype.hasOwnProperty.call(parsed, key)) {\n600:       clean[key] = parsed[key];\n601:     }\n602:   }\n603:   return clean;\n604: }\n605: \n606: function buildFinalReviewLedgerSummary(finalReview) {\n607:   if (!finalReview) return null;\n608:   const redactedAnswer = finalReview.answer ? redactSensitiveText(finalReview.answer) : null;\n609:   const parsed = parsedReviewClassification(finalReview.parsed);\n610:   const attempts = Array.isArray(finalReview.attempts) ? finalReview.attempts : [];\n611:   return {\n612:     mode: finalReview.mode || 'kimi_final_adjudication',\n613:     enabled: finalReview.enabled === true,\n614:     ok: finalReview.ok === true,\n615:     provider: finalReview.provider || null,\n616:     model: finalReview.model || null,\n617:     latency_ms: finalReview.latencyMs == null ? null : finalReview.latencyMs,\n618:     error: finalReview.error || null,\n619:     applied_model: finalReview.appliedModel || null,\n620:     identity_posture: finalReview.identityPosture || null,\n621:     stage_receipt: finalReview.stageReceipt || null,\n622:     quarantines: Array.isArray(finalReview.quarantines) ? finalReview.quarantines : [],\n623:     repo_adjudication: finalReview.repoAdjudication || { status: 'pending', authority: 'live_repo_required' },\n624:     doctrine_review: finalReview.doctrineReview || null,\n625:     ...seatReceiptFields(redactedAnswer, attempts, finalReview.error ? 'reviewer_failed' : null),\n626:     provider_attempts: attempts,\n627:     parsed,\n628:     effective_verdict: parsed && parsed.verdict ? parsed.verdict : null,\n629:     answer_excerpt: redactedAnswer\n630:       ? truncateText(redactedAnswer, ANSWER_EXCERPT_MAX)\n631:       : null,\n632:     answer_full: redactedAnswer,\n633:   };\n634: }\n635: \n636: function buildReviewLedgerSummary(review) {\n637:   if (!review) return null;\n638:   const rechecks = Array.isArray(review.rechecks)\n639:     ? review.rechecks\n640:     : (review.recheck ? [review.recheck] : []);\n","exit_code":0,"status":"completed"}}
