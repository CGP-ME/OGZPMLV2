);\n1111:     }\n1112:     const response = await client.generateResponseWithMetadata(prompt, client.maxTokens);\n1113:     const responseMetadata = response.metadata || {};\n1114:     if (role !== 'astra_challenger' && Array.isArray(responseMetadata.toolsAvailable) && responseMetadata.toolsAvailable.length > 0) {\n1115:       const error = new Error(`${role} unexpectedly exposed tools in a prompt-only stage`);\n1116:       error.providerMetadata = responseMetadata;\n1117:       throw error;\n1118:     }\n1119:     let rawOutput;\n1120:     let rawError;\n1121:     try {\n1122:       rawOutput = persistRaw(role, attemptNumber, responseMetadata.rawResponse || Buffer.alloc(0));\n1123:       rawError = responseMetadata.rawError && responseMetadata.rawError.length > 0\n1124:         ? persistRaw(`${role}-stderr`, attemptNumber, responseMetadata.rawError)\n1125:         : null;\n1126:     } catch (persistError) {\n1127:       persistError.providerMetadata = responseMetadata;\n1128:       persistError.rawPersistenceFailed = true;\n1129:       persistError.persistedRawOutput = rawOutput || null;\n1130:       throw persistError;\n1131:     }\n1132:     const receipt = stageAttemptReceipt({\n1133:       role, attemptNumber, metadata: responseMetadata,\n1134:       status: ['error', 'incomplete'].includes(responseMetadata.termination) ? 'failed' : 'succeeded',\n1135:       prompt, suppliedSources, rawOutput, rawError, inputProvenance,\n1136:     });\n1137:     receipt.claimed_file_citations = extractClaimedFileCitations(response.answer);\n1138:     return { answer: response.answer, receipt };\n1139:   } catch (error) {\n1140:     const roleIdentity = role === 'kimi_tie_breaker'\n1141:       ? { provider: config.TIE_BREAKER_PROVIDER, requestedModel: config.TIE_BREAKER_MODEL }\n1142:       : {\n1143:         provider: config.CONSENSUS_PROVIDER,\n1144:         requestedModel: role === 'opus_challenger' ? config.CONSENSUS_EMERGENCY_MODEL : config.CONSENSUS_MODEL,\n1145:       };\n1146:     const metadata = {\n1147:       provider: client && client.providerName ? client.providerName : roleIdentity.provider,\n1148:       requestedModel: client && client.model ? client.model : roleIdentity.requestedModel,\n1149:       startedAt: startedAt.toISOString(),\n1150:       finishedAt: new Date().toISOString(),\n1151:       latencyMs: Date.now() - startedAt.getTime(),\n1152:       termination: 'error',\n1153:       parseStatus: 'request_failed',\n1154:       ...(error.providerMetadata || {}),\n1155:     };\n1156:     let rawOutput = error.persistedRawOutput || null;\n1157:     let rawError = null;\n1158:     if (!error.rawPersistenceFailed) {\n1159:       try {\n1160:         rawOutput = persistRaw(role, attemptNumber, metadata.rawResponse || Buffer.alloc(0));\n1161:         rawError = metadata.rawError && metadata.rawError.length > 0\n1162:           ? persistRaw(`${role}-stderr`, attemptNumber, metadata.rawError)\n1163:           : null;\n1164:       } catch (persistError) {\n1165:         persistError.providerMetadata = metadata;\n1166:         persistError.rawPersistenceFailed = true;\n1167:         persistError.providerFailure = sanitizeForLedger(error.message);\n1168:         error = persistError;\n1169:       }\n1170:     }\n1171:     error.stageAttempt = stageAttemptReceipt({\n1172:       role, attemptNumber, metadata, status: 'failed', error,\n1173:       prompt, suppliedSources, rawOutput, rawError, inputProvenance,\n1174:     });\n1175:     throw error;\n1176:   }\n1177: }\n1178: \n1179: async function runAstraAdversarialReview({\n1180:   query,\n1181:   reviewRoot,\n1182:   mercuryResult,\n1183:   runLedgerCitation = null,\n1184:   reviewIntent = 'adversarial',\n1185:   createAstraClient = createAstraChallengerClient,\n1186:   persistRaw = () => null,\n1187:   now = Date.now,\n1188:   evidenceSources = [],\n1189:   hostEvidenceSources = [],\n1190: } = {}) {\n1191:   const started = now();\n1192:   const attempts = [];\n1193:   const quarantines = [];\n1194:   let prompt;\n1195:   let suppliedSources;\n1196:   try {\n1197:     prompt = buildAdversarialReviewPrompt({\n1198:       query, mercuryResult, runLedgerCitation, reviewIntent, evidenceSources, hostEvidenceSources,\n1199:     });\n1200:     suppliedSources = [\n1201:       { path: 'input://original-query', excerpt: query.trim() },\n1202:       ...evidenceSources,\n1203:       ...reviewerEvidenceSources({ mercuryResult, hostEvidenceSources }),\n1204:       { path: mercuryResult.panelSourcePath || 'mercury://primary-answer', excerpt: String(mercuryResult.answer || '').trim() || '<empty>' },\n1205:       ...(runLedgerCitation ? [{ path: 'mercury://run-ledger-citation', excerpt: runLedgerCitation }] : []),\n1206:     ];\n1207:     buildAttestedPromptProvenance(prompt, suppliedSources);\n1208:   } catch (error) {\n1209:     if (isHardReviewBoundaryError(error)) throw error;\n1210:     return adversarialReviewFailure(error, {\n1211:       quarantines: [reviewQuarantine({\n1212:         unit: 'challenger',\n1213:         name: 'astra_challenger',\n1214:         absence: '[REDACTED]',\n1215:         error,\n1216:       })],\n1217:     });\n1218:   }\n1219:   let stage;\n1220:   try {\n1221:     stage = await executePromptOnlyStage({\n1222:       role: 'astra_challenger', repoRoot: reviewRoot, prompt, suppliedSources,\n1223:       createClient: createAstraClient, persistRaw, attemptNumber: 1,\n1224:     });\n1225:     attempts.push(stage.receipt);\n1226:     if (stage.receipt.identity_posture.status === 'identity_conflict') {\n1227:       quarantines.push(reviewQuarantine({\n1228:         unit: 'identity',\n1229:         name: 'astra_challenger',\n1230:         absence: 'identity_conflict',\n1231:         loadBearing: true,\n1232:         attempts: [stage.receipt],\n1233:       }));\n1234:     }\n1235:   } catch (error) {\n1236:     if (error.stageAttempt) attempts.push(error.stageAttempt);\n1237:     error.challengerAttempts = attempts;\n1238:     if (is