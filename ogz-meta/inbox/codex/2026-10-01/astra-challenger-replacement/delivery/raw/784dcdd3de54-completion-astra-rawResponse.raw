n    15\t  redactSensitiveText,\n    16\t  writeRawProviderOutput,\n    17\t  writeRunLedgerEntry,\n    18\t} = require('./run-ledger');\n    19\tconst { accountProviderAttempt } = require('./cost-accounting');\n    20\tconst { responseStopReason } = require('../../core/persistent_llm_client');\n    21\t\n    22\tconst PREFLIGHT_PROMPT = 'Reply with exactly: PROVIDER_OK';\n    23\t\n    24\tfunction classifyProviderError(err) {\n    25\t  const message = err && err.message ? err.message : String(err);\n    26\t  if (/free_tier_quota_exceeded|free tier limit|insufficient balance|rate limit|requires a subscription|upgrade for access|HTTP 402|HTTP 403|HTTP 429/i.test(message)) {\n    27\t    return 'quota_or_billing';\n    28\t  }\n    29\t  if (/authentication_error|invalid x-api-key|HTTP 401|api key env is missing|missing/i.test(message)) {\n    30\t    return 'auth';\n    31\t  }\n    32\t  if (/model.*not.*found|not_found|does not exist|unsupported/i.test(message)) {\n    33\t    return 'model';\n    34\t  }\n    35\t  if (/timeout|ETIMEDOUT|ECONNRESET|ENOTFOUND|EAI_AGAIN/i.test(message)) {\n    36\t    return 'network';\n    37\t  }\n    38\t  return 'unknown';\n    39\t}\n    40\t\n    41\tfunction sanitizeProviderMessage(message) {\n    42\t  return redactSensitiveText(String(message == null ? '' : message))\n    43\t    .replace(/(\"request_id\"\\s*:\\s*\")[^\"]+(\")/gi, '$1[REDACTED]$2')\n    44\t    .replace(/\\borg-[a-z0-9_-]+\\b/gi, 'org-[REDACTED]')\n    45\t    .replace(/<ak-[^>]+>/gi, '<account-[REDACTED]>')\n    46\t    .replace(/\\(ref:\\s*[0-9a-f-]{16,}\\)/gi, '(ref: [REDACTED])');\n    47\t}\n    48\t\n    49\tfunction cleanProviderError(err) {\n    50\t  const clean = {\n    51\t    category: classifyProviderError(err),\n    52\t    message: sanitizeProviderMessage(err && err.message ? err.message : String(err)),\n    53\t  };\n    54\t  if (err && ['string', 'number'].includes(typeof err.code)) clean.code = err.code;\n    55\t  if (err && typeof err.subcondition === 'string') clean.subcondition = err.subcondition;\n    56\t  if (err && Array.isArray(err.subconditions)) clean.subconditions = [...err.subconditions];\n    57\t  return clean;\n    58\t}\n    59\t\n    60\tasync function withSilencedClientConsole(fn) {\n    61\t  const originalLog = console.log;\n    62\t  const originalError = console.error;\n    63\t  console.log = () => {};\n    64\t  console.error = () => {};\n    65\t  try {\n    66\t    return await fn();\n    67\t  } finally {\n    68\t    console.log = originalLog;\n    69\t    console.error = originalError;\n    70\t  }\n    71\t}\n    72\t\n    73\tfunction attemptReceipt({ label, attempt, client, metadata = {}, status, phase, error = null, rawOutput = null, rawError = null }) {\n    74\t  const promptDispatched = phase === 'generate' || phase === 'complete';\n    75\t  const identityPosture = stampedIdentityPosture(metadata);\n    76\t  const requestedProvider = metadata.provider || (client && client.providerName) || null;\n    77\t  const requestedModel = metadata.requestedModel || (client && client.model) || null;\n    78\t  const accounting = accountProviderAttempt(metadata, {\n    79\t    provider: requestedProvider,\n    80\t    model: requestedModel,\n    81\t    pricingCatalog: config.PROVIDER_PRICING,\n    82\t  });\n    83\t  return {\n    84\t    role: label,\n    85\t    attempt,\n    86\t    status,\n    87\t    request_phase: phase,\n    88\t    requested_provider: requestedProvider,\n    89\t    requested_model: requestedModel,\n    90\t    applied_model: metadata.appliedModel || null,\n    91\t    applied_models: Array.isArray(metadata.appliedModels)\n    92\t      ? [...metadata.appliedModels]\n    93\t      : (metadata.appliedModel ? [metadata.appliedModel] : []),\n    94\t    auxiliary_models: Array.isArray(metadata.auxiliaryModels) ? [...metadata.auxiliaryModels] : [],\n    95\t    verdict_models: Array.isArray(metadata.verdictModels) ? [...metadata.verdictModels] : [],\n    96\t    identity_posture: identityPosture,\n    97\t    model_observations: Array.isArray(metadata.modelObservations) ? [...metadata.modelObservations] : [],\n    98\t    model_transitions: Array.isArray(metadata.modelTransitions) ? [...metadata.modelTransitions] : [],\n    99\t    started_at: metadata.startedAt || null,\n   100\t    finished_at: metadata.finishedAt || null,\n   101\t    latency_ms: metadata.latencyMs == null ? null : metadata.latencyMs,\n   102\t    status_code: metadata.statusCode == null ? null : metadata.statusCode,\n   103\t    exit_code: metadata.exitCode == null ? null : metadata.exitCode,\n   104\t    termination: metadata.termination || null,\n   105\t    stopped_because: redactSensitiveText(\n   106\t      metadata.stoppedBecause && metadata.stoppedBecause !== 'provider_stop_reason_absent'\n   107\t        ? metadata.stoppedBecause\n   108\t        : responseStopReason({\n   109\t          termination: metadata.termination,\n   110\t          statusCode: metadata.statusCode,\n   111\t          providerError: error && error.message,\n   112\t        })\n   113\t    ),\n   114\t    parse_status: metadata.parseStatus || null,\n   115\t    parse_errors: metadata.parseErrors || [],\n   116\t    provider_error: metadata.providerError || null,\n   117\t    provider_errors: metadata.providerErrors || [],\n   118\t    tokens: accounting.tokens,\n   119\t    usage_absence: accounting.usage_absence,\n   120\t    cost: accounting.cost,\n   121\t    cost_absence: accounting.cost_absence,\n   122\t    input_provenance: promptDispatched ? buildPromptProvenance(PREFLIGHT_PROMPT) : null,\n   123\t    raw_output: rawOutput,\n   124\t    raw_error: rawError,\n   125\t    tools: metadata.tools || {\n   126\t      enabled: false,\n   127\t      available: Array.isArray(metadata.toolsAvailable) ? metadata.toolsAvailable : [],\n   128\t      calls: [],\n   129\t      total: 0,\n   130\t      succeeded: 0,\n   131\t      failed: 0,\n   132\t    },\n   133\t    files_mechanically_opened: [],\n   134\t    invocation: metadata.invocation || null,\n   135\t    initialization: metadata.initialization || null,\n   136\t    auth_posture: metadata.authStatus || (client && client.authStatus) || null,\n   137\t    executable_trust: metadata.executableTrust || (client && client.executableTrust) || null,\n   138\t    error: error ? cleanProviderError(error) : null,\n   139\t    repo_adjudication: { status: 'pending', authority: 'live_repo_required' },\n   140\t  };\n   141\t}\n   142\t\n   143\tfunction persistAttemptRaw({ repoRoot, runId, label, attempt, metadata }) {\n   144\t  if (!repoRoot) return { rawOutput: null, rawError: null };\n   145\t  const rawOutput = writeRawProviderOutput({\n   146\t    repoRoot,\n   147\t    runId,\n   148\t    stage: label,\n   149\t    attempt,\n   150\t    bytes: metadata.rawResponse || Buffer.alloc(0),\n   151\t  });\n   152\t  const rawError = metadata.rawError && metadata.rawError.length > 0\n   153\t    ? writeRawProviderOutput({\n   154\t      repoRoot,\n   155\t      runId,\n   156\t      stage: `${label}-stderr`,\n   157\t      attempt,\n   158\t      bytes: metadata.rawError,\n   159\t    })\n   160\t    : null;\n   161\t  return { rawOutput, rawError };\n   162\t}\n   163\t\n   164\tasync function checkClient(label, createClient, { attempt = 1, repoRoot = null, runId = null } = {}) {\n   165\t  const startedAt = new Date();\n   166\t  const startedMs = Date.now();\n   167\t  let client = null;\n   168\t  let phase = 'create';\n   169\t  try {\n   170\t    client = createClient();\n   171\t    phase = 'initialize';\n   172\t    await withSilencedClientConsole(() => client.initialize());\n   173\t    let appliedModel = null;\n   174\t    let metadata = {\n   175\t      provider: client.providerName,\n   176\t      requestedModel: client.model,\n   177\t      appliedModel: null,\n   178\t      toolsAvailable: [],\n   179\t    };\n   180\t    if (typeof client.generateResponseWithMetadata === 'function') {\n   181\t      phase = 'generate';\n   182\t      const response = await withSilencedClientConsole(() => client.generateResponseWithMetadata(\n   183\t        PREFLIGHT_PROMPT\n   184\t      ));\n   185\t      appliedModel = response.metadata.appliedModel;\n   186\t      metadata = response.metadata;\n   187\t    }\n   188\t    phase = 'complete';\n   189\t    const raw = persistAttemptRaw({ repoRoot, runId, label, attempt, metadata });\n   190\t    const completed = !['error', 'incomplete'].includes(metadata.termination);\n   191\t    const result = {\n   192\t      label,\n   193\t      ok: completed,\n   194\t      provider: client.providerName,\n   195\t      model: client.model,\n   196\t      appliedModel,\n   197\t      identityPosture: stampedIdentityPosture(metadata),\n   198\t      requests: client.requestCount,\n   199\t      authPosture: client.authStatus || null,\n   200\t    };\n   201\t    result.attemptReceipt = attemptReceipt({\n   202\t      label, attempt, client, metadata,\n   203\t      status: completed ? 'succeeded' : 'failed', phase, ...raw,\n   204\t    });\n   205\t    return result;\n   206\t  } catch (err) {\n   207\t    const metadata = err && err.providerMetadata ? err.providerMetadata : {\n   208\t      provider: client && client.providerName,\n   209\t      requestedModel: client && client.model,\n   210\t      startedAt: startedAt.toISOString(),\n   211\t      finishedAt: new Date().toISOString(),\n   212\t      latencyMs: Date.now() - startedMs,\n   213\t      termination: 'error',\n   214\t      parseStatus: 'request_failed',\n   215\t      toolsAvailable: [],\n   216\t    };\n   217\t    const raw = persistAttemptRaw({ repoRoot, runId, label, attempt, metadata });\n   218\t    const result = {\n   219\t      label,\n   220\t      ok: false,\n   221\t      provider: client && client.providerName ? client.providerName : null,\n   222\t      model: client && client.model ? client.model : null,\n   223\t      err