# OGZPrime credential and capability template
#
# Copy the keys you use into the repository-root `.env` file and supply the
# real values there. Never commit that file. Keep trading behavior, thresholds,
# feature switches, paths, ports, and strategy settings out of `.env`:
#
#   config/settings.json  customer-visible and trading behavior
#   config/internals.json implementation constants
#   typed run descriptor  per-backtest identity, data, profiles, and overrides
#
# PROFILE is a per-launch inherited bootstrap input. It is intentionally not a
# stored `.env` value. Backtests receive their launch profile through the typed
# run descriptor.

# Broker and market-data credentials
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=
BROKER_ACCOUNT_ID=
POLYGON_API_KEY=

# Dashboard, webhooks, and notifications
WEBSOCKET_AUTH_TOKEN=
SIGNALSTACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_STATUS_WEBHOOK_URL=
DISCORD_STATS_WEBHOOK_URL=
NTFY_TOPIC=

# Monitoring and process capabilities
SENTRY_DSN=
SUPERVISOR_DEADMAN_URL=

# News and search credentials
BRIGHTDATA_API_KEY=
TAVILY_API_KEY=

# TrAI, voice, and media credentials
INCEPTION_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DID_API_KEY=

# Checkout
STRIPE_SECRET_KEY=

# Mercury provider credentials selected by mercury.config.json
INCEPTION_API_KEY_DEV=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# Optional capability used by Mercury's GitHub reader
GITHUB_TOKEN=
