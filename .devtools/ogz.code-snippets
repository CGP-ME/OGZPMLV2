{
  "OGZ: New Service Module Header": {
    "prefix": "ogzheader",
    "body": [
      "/**",
      " * ${1:ModuleName} - OGZPrime Service",
      " * File: ${TM_FILENAME/(.*)/${1:/kebabcase}/}",
      " * Generated: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      " */",
      "",
      "\"use strict\";",
      "",
      "module.exports = class ${1:ModuleName} {",
      "  constructor(config = {}) {",
      "    this.config = config;",
      "  }",
      "",
      "  async start() {",
      "    // TODO: init",
      "  }",
      "",
      "  async stop() {",
      "    // TODO: cleanup",
      "  }",
      "};"
    ],
    "description": "OGZPrime module header + class skeleton with kebabcase filename transform"
  },

  "OGZ: Structured Log Line": {
    "prefix": "ogzlog",
    "body": [
      "console.log(JSON.stringify({",
      "  ts: Date.now(),",
      "  level: \"${1:info}\",",
      "  component: \"${2:component}\",",
      "  msg: \"${3:message}\",",
      "  meta: ${4:{}}",
      "}));"
    ],
    "description": "Consistent structured logging line (JSON)"
  },

  "OGZ: Canonical Configuration Read": {
    "prefix": "ogzconfig",
    "body": [
      "const ${1:value} = resolvedConfig.config.${2:path};"
    ],
    "description": "Read a value from the ConfigLoader-produced runtime snapshot"
  }
}
